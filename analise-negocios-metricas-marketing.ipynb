   "source": [
    "# Criando o gráfico de linhas da taxa de conversão de cada grupo como a proporção de pedidos para o número de visitas para cada dia\n",
    "plt.figure(figsize=(15, 6))\n",
    "sns.lineplot(data=orders_visits_per_date_group, x='date', y='daily_exchange_rate', hue='group')\n",
    "plt.xticks(rotation=45, ha='right')\n",
    "plt.title('Taxa de Conversão do Grupo A e do Grupo B')\n",
    "plt.xlabel('Data')\n",
    "plt.ylabel('Taxa de Conversão Diária')\n",
    "plt.show()"
   ]
