   ],
   "source": [
    "# Aplicando o framework RICE para priorizar hipóteses e classificando em ordem decrescente de prioridade\n",
    "hypotheses_df['RICE'] =  ((hypotheses_df['reach']) * (hypotheses_df['impact']) * (hypotheses_df['confidence']))/ (hypotheses_df['effort'])  \n",
    "print(hypotheses_df[['hypothesis', 'RICE']].sort_values(by='RICE', ascending=False)) "
   ]
