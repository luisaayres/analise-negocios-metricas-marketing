   "source": [
    "# Exibindo uma tabela comparativa de ICE e RICE\n",
    "print(hypotheses_df[['hypothesis', 'ICE', 'ICE_rank', 'RICE', 'RICE_rank']].sort_values(by='RICE_rank'))"
   ]
