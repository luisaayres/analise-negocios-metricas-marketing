   ],
   "source": [
    "# Aplicando o framework ICE para priorizar hipóteses e classificando em ordem decrescente de prioridade\n",
    "hypotheses_df['ICE'] =  ((hypotheses_df['impact']) * (hypotheses_df['confidence']))/ (hypotheses_df['effort'])\n",
    "print(hypotheses_df[['hypothesis', 'ICE']].sort_values(by='ICE', ascending=False)) "
